        w_rst, r_rst, w_inc, r_inc, wr_data, rd_data, empty, full );
  input [7:0] wr_data;
  output [7:0] rd_data;
  input w_clk, r_clk, w_rst, r_rst, w_inc, r_inc;
  output empty, full;
  wire   wr_en, n1, n2, n3, n4;
  wire   [3:0] synch_wptr;
  wire   [2:0] read_address;
  wire   [3:0] asynch_rptr;
  wire   [3:0] synch_rptr;
  wire   [2:0] write_address;
  wire   [3:0] asynch_wptr;

  FIFO_RD_FIFO_DEPTH8_ADD_W3_PTR_W4 u_FIFO_RD ( .r_clk(r_clk), .r_rst(n1), 
        .r_inc(r_inc), .sync_wptr(synch_wptr), .raddr(read_address), 
        .gray_r_ptr(asynch_rptr), .empty(empty) );
  FIFO_WR_FIFO_DEPTH8_ADD_W3_PTR_W4 u_FIFO_WR ( .w_clk(w_clk), .w_rst(n3), 
        .w_inc(w_inc), .sync_rptr(synch_rptr), .waddr(write_address), 
        .gray_wr_ptr(asynch_wptr), .full(full) );
  DF_SYNC_PTR_W4_0 u_DF_SYNC_R ( .clk(w_clk), .rst(n3), .asynch_data(
        asynch_rptr), .synch_data(synch_rptr) );
  DF_SYNC_PTR_W4_1 u_DF_SYNC_W ( .clk(r_clk), .rst(n1), .asynch_data(
        asynch_wptr), .synch_data(synch_wptr) );
  FIFO_MEM_CNTRL_DATA_BUS_WIDTH8_FIFO_DEPTH8_ADD_W3 u_FIFO_MEM_CNTRL ( 
        .wr_clk(w_clk), .wr_rst(n3), .wdata(wr_data), .W_INC(wr_en), .waddr(
        write_address), .raddr(read_address), .rdata(rd_data) );
  INVX2M U1 ( .A(n4), .Y(n3) );
  INVX2M U2 ( .A(w_rst), .Y(n4) );
  INVX2M U3 ( .A(n2), .Y(n1) );
  INVX2M U4 ( .A(r_rst), .Y(n2) );
