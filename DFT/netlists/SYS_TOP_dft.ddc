module MUX ( ser_data, parity, mux_s, TX_out );
  input [1:0] mux_s;
  input ser_data, parity;
  output TX_out;
  wire   n2, n3, n1;

  OAI21X4M U3 ( .A0(n2), .A1(n1), .B0(n3), .Y(TX_out) );
  NAND3X2M U4 ( .A(mux_s[1]), .B(n1), .C(ser_data), .Y(n3) );
  NOR2BX2M U5 ( .AN(mux_s[1]), .B(parity), .Y(n2) );
  INVX2M U6 ( .A(mux_s[0]), .Y(n1) );
endmodule


